# Copy to .env and fill in. .env is gitignored.
# Reuse the KIT SCC AI toolbox key (same one the KARMA project uses).
KIT_API_KEY=your_kit_scc_toolbox_key_here
KIT_BASE_URL=https://ki-toolbox.scc.kit.edu/api/v1
VLM_MODEL=kit.qwen3.5-397b-A17b
VLM_TEMPERATURE=0.0
VLM_TIMEOUT=120
VLM_MAX_ATTEMPTS=5
VLM_RETRY_DELAYS_S=30,120,300,600
VLM_CONCURRENCY=8
