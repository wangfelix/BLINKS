# ---------------------------------------------------------------------------
# Power management. This is the entire point of this build.
# ---------------------------------------------------------------------------
# Tickless idle lets FreeRTOS put the chip into light sleep in the gaps between
# BLE connection events instead of halting the core with all clocks running.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# ---------------------------------------------------------------------------
# Low-power clock: use the board's 32.768 kHz crystal (X1, XL1/XL2 on GPIO15/16)
# ---------------------------------------------------------------------------
# The BT controller needs an accurate low-power clock to keep connection timing
# across light sleep. Michael fitted this crystal specifically so the device
# could sleep; the Arduino build never used it.
CONFIG_RTC_CLK_SRC_EXT_CRYS=y
CONFIG_RTC_CLK_CAL_CYCLES=1024

# ---------------------------------------------------------------------------
# Bluetooth controller sleep
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_EXT_32K_XTAL=y

# ---------------------------------------------------------------------------
# Board: ESP32-S3-MINI-1U-N4R2
# ---------------------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Leakage workarounds matter once the chip actually sleeps with PSRAM fitted.
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y
CONFIG_ESP_SLEEP_FLASH_LEAKAGE_WORKAROUND=y

# ---------------------------------------------------------------------------
# Arduino-as-a-component requirements
# ---------------------------------------------------------------------------
# Arduino's CMakeLists hard-fails without a 1 kHz tick. It also matters for
# light sleep: the tick period is the granularity tickless idle works in, and
# FREERTOS_IDLE_TIME_BEFORE_SLEEP above is counted in ticks, so 3 == 3 ms here.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# Without this Arduino never defines app_main, so setup() and loop() are never
# called. It defaults to n, and PlatformIO does not set it for you: the board
# would boot happily and do absolutely nothing.
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUHAL_ESP_LOG=y

# ps_malloc() in sendFrame's JPEG copy needs PSRAM in the capability heap.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y

# Hold off light sleep while USB is actually connected. The chip is otherwise
# free to sleep through USB frame packets, which can garble enumeration and
# swallow the keypress that dumps the battery log. With this set the lock is
# released a moment after the host disappears, so a battery run still sleeps.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
