{
  "expo": {
    "name": "BLINKS BLE Spike",
    "slug": "blinks-ble-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "edu.kit.blinks.blespike",
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow BLINKS to connect to the camera"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset",
      "./plugins/withNotifeeForegroundServiceType.js"
    ],
    "extra": {
      "eas": {
        "projectId": "dc64b6aa-3041-45e9-a969-d72d0deb8565"
      }
    }
  }
}
